# Database — SQLite for local development. Use PostgreSQL in production.
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AA Maka Production"
NEXT_PUBLIC_CURRENCY="PKR"

# Bootstrap admin created by prisma/seed.ts
ADMIN_EMAIL="admin@aamaka.local"
ADMIN_PASSWORD="ChangeMe_Admin_123!"
ADMIN_NAME="AA Maka Admin"

# File storage. Local disk by default; set STORAGE_DRIVER=s3 for object storage later.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3 / compatible object storage (optional)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# Signed media URL lifetime in seconds
MEDIA_URL_TTL="300"
MEDIA_SIGNING_SECRET="replace-with-another-long-random-secret"

# Payments — leave blank until a provider is configured. COD and bank transfer work without a card gateway.
PAYMENT_CURRENCY="PKR"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGERITY_SALT=""
EASYPAISA_STORE_ID=""
BANK_TRANSFER_INSTRUCTIONS="Bank: HBL\nTitle: AA Maka Production\nAccount: 0000-00000000-00\nIBAN: PK00HABB0000000000000000"

# Email — console transport is used when SMTP is not set.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AA Maka Production <noreply@aamaka.local>"
NOTIFY_ADMIN_EMAIL="admin@aamaka.local"

# Analytics (optional, loaded only when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Rate limiting (in-memory by default)
RATE_LIMIT_LOGIN="8"
RATE_LIMIT_CONTACT="5"
